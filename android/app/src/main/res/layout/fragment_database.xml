<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="4dp"
    android:orientation="vertical"
    tools:ignore="HardcodedText,UselessParent,UnusedAttribute,ContentDescription,Autofill,LabelFor,TextFields,RtlSymmetry,UseCompoundDrawables,ObsoleteLayoutParam">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_2"
            android:showDividers="middle"
            android:orientation="vertical">
            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Bold"
                android:textSize="24sp"
                android:textColor="@color/text"
                android:text="Database"
                android:letterSpacing="-0.017" />
            <TextView
                android:id="@+id/hdr_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Reg"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:text="" />
        </LinearLayout>
        <TextView
            android:id="@+id/db_health"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_f_greena14_r99"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            style="@style/T.Semi"
            android:textSize="11sp"
            android:textColor="@color/green"
            android:text="" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:divider="@drawable/gap_12"
            android:showDividers="middle"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/seg_db"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:padding="4dp"
                android:background="@drawable/bg_f_card_s_stroke_w1_r16"
                android:divider="@drawable/gap_4"
                android:showDividers="middle"
                android:orientation="horizontal" />
            <LinearLayout
                android:id="@+id/chips_db"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="horizontal" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_10"
                android:showDividers="middle"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r20"
                    android:divider="@drawable/gap_7"
                    android:showDividers="middle"
                    android:orientation="vertical">
                    <FrameLayout android:layout_width="72dp"
                        android:layout_height="72dp">
                        <com.example.netops.RingView
                            android:id="@+id/rc0_ring"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:ringColor="@color/cyan"
                            app:ringTrack="@color/stroke"
                            app:ringStroke="7dp"
                            app:ringProgress="0"
                            android:layout_gravity="center" />
                        <TextView
                            android:id="@+id/rc0_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            style="@style/T.Bold"
                            android:textSize="16sp"
                            android:textColor="@color/text"
                            android:text="" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/rc0_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="12sp"
                        android:textColor="@color/text"
                        android:text="" />
                    <TextView
                        android:id="@+id/rc0_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Reg"
                        android:textSize="10sp"
                        android:textColor="@color/muted"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r20"
                    android:divider="@drawable/gap_7"
                    android:showDividers="middle"
                    android:orientation="vertical">
                    <FrameLayout android:layout_width="72dp"
                        android:layout_height="72dp">
                        <com.example.netops.RingView
                            android:id="@+id/rc1_ring"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:ringColor="@color/cyan"
                            app:ringTrack="@color/stroke"
                            app:ringStroke="7dp"
                            app:ringProgress="0"
                            android:layout_gravity="center" />
                        <TextView
                            android:id="@+id/rc1_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            style="@style/T.Bold"
                            android:textSize="16sp"
                            android:textColor="@color/text"
                            android:text="" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/rc1_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="12sp"
                        android:textColor="@color/text"
                        android:text="" />
                    <TextView
                        android:id="@+id/rc1_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Reg"
                        android:textSize="10sp"
                        android:textColor="@color/muted"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r20"
                    android:divider="@drawable/gap_7"
                    android:showDividers="middle"
                    android:orientation="vertical">
                    <FrameLayout android:layout_width="72dp"
                        android:layout_height="72dp">
                        <com.example.netops.RingView
                            android:id="@+id/rc2_ring"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:ringColor="@color/cyan"
                            app:ringTrack="@color/stroke"
                            app:ringStroke="7dp"
                            app:ringProgress="0"
                            android:layout_gravity="center" />
                        <TextView
                            android:id="@+id/rc2_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            style="@style/T.Bold"
                            android:textSize="16sp"
                            android:textColor="@color/text"
                            android:text="" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/rc2_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="12sp"
                        android:textColor="@color/text"
                        android:text="" />
                    <TextView
                        android:id="@+id/rc2_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Reg"
                        android:textSize="10sp"
                        android:textColor="@color/muted"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_f_card_s_greena40_w1_r20"
                android:divider="@drawable/gap_12"
                android:showDividers="middle"
                android:orientation="horizontal">
                <FrameLayout android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_f_greena14_r14">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lock"
                        android:tint="@color/green" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:divider="@drawable/gap_4"
                    android:showDividers="middle"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Bold"
                        android:textSize="14sp"
                        android:textColor="@color/text"
                        android:text="SSH tunnel locked" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Reg"
                        android:textSize="11sp"
                        android:textColor="@color/muted"
                        android:text="SSH-PRI-KEY · AES-256 · read-guarded"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_f_greena14_r99"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    style="@style/T.Semi"
                    android:textSize="11sp"
                    android:textColor="@color/green"
                    android:text="SECURED" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_f_card_s_stroke_w1_r20"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="13dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/T.Med"
                        android:textSize="13sp"
                        android:textColor="@color/muted"
                        android:text="Engine" />
                    <TextView
                        android:id="@+id/dbt_engine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:text="" />
                </LinearLayout>
                <View android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="13dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/T.Med"
                        android:textSize="13sp"
                        android:textColor="@color/muted"
                        android:text="Last backup" />
                    <TextView
                        android:id="@+id/dbt_last"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:text="" />
                </LinearLayout>
                <View android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="13dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/T.Med"
                        android:textSize="13sp"
                        android:textColor="@color/muted"
                        android:text="Replicas" />
                    <TextView
                        android:id="@+id/dbt_rep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/dbt_btn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center"
                android:background="@drawable/bg_g_h_r16"
                android:elevation="12dp"
                android:outlineAmbientShadowColor="#8022D3EE"
                android:outlineSpotShadowColor="#8022D3EE"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="horizontal">
                <ImageView android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_database"
                    android:tint="@color/on_cyan" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Semi"
                    android:textSize="16sp"
                    android:textColor="@color/on_cyan"
                    android:text="Trigger Backup" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
