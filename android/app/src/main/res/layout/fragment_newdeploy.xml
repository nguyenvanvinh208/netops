<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="4dp"
    android:orientation="vertical"
    tools:ignore="HardcodedText,UselessParent,UnusedAttribute,ContentDescription,Autofill,LabelFor,TextFields,RtlSymmetry,UseCompoundDrawables,ObsoleteLayoutParam">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:divider="@drawable/gap_12"
        android:showDividers="middle"
        android:orientation="horizontal">
        <FrameLayout android:id="@+id/hdr_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_f_card_s_stroke_w1_r14">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                android:tint="@color/text" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_2"
            android:showDividers="middle"
            android:orientation="vertical">
            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Bold"
                android:textSize="22sp"
                android:textColor="@color/text"
                android:text="New deployment"
                android:letterSpacing="-0.018"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/hdr_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Reg"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:text="Configure &amp; launch a container"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:divider="@drawable/gap_14"
            android:showDividers="middle"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Semi"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:text="CONTAINER NAME"
                    android:letterSpacing="0.073" />
                <LinearLayout
                    android:id="@+id/nd_name_box"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r16"
                    android:divider="@drawable/gap_10"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_box"
                        android:tint="@color/cyan" />
                    <EditText
                        android:id="@+id/nd_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Input"
                        android:layout_weight="1"
                        android:inputType="text"
                        android:maxLines="1"
                        android:text="web-api-canary" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Semi"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:text="REGISTRY IMAGE"
                    android:letterSpacing="0.073" />
                <LinearLayout
                    android:id="@+id/nd_img_row"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r16"
                    android:divider="@drawable/gap_10"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_cloud"
                        android:tint="@color/dim" />
                    <TextView
                        android:id="@+id/nd_img_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/T.Med"
                        android:textSize="15sp"
                        android:textColor="@color/text"
                        android:text="" />
                    <TextView
                        android:id="@+id/nd_img_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        style="@style/T.Semi"
                        android:textSize="11sp"
                        android:textColor="@color/violet"
                        android:text="" />
                    <ImageView android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevd"
                        android:tint="@color/muted" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nd_menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r16"
                    android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Semi"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:text="TARGET SERVER"
                    android:letterSpacing="0.073" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_12"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/nd_srv0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="14dp"
                        android:background="@drawable/bg_f_card_s_stroke_w1_r18"
                        android:divider="@drawable/gap_8"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <FrameLayout android:id="@+id/nd_srv0_tile"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_f_muteda14_r12">
                                <ImageView
                                    android:id="@+id/nd_srv0_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_server"
                                    android:tint="@color/muted" />
                            </FrameLayout>
                            <Space android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />
                            <FrameLayout android:id="@+id/nd_srv0_chk"
                                android:layout_width="22dp"
                                android:layout_height="22dp">
                                <ImageView
                                    android:id="@+id/nd_srv0_chkicon"
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:tint="@color/on_cyan" />
                            </FrameLayout>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/nd_srv0_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="4dp"
                            style="@style/T.Bold"
                            android:textSize="15sp"
                            android:textColor="@color/text"
                            android:text="" />
                        <TextView
                            android:id="@+id/nd_srv0_free"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Reg"
                            android:textSize="11sp"
                            android:textColor="@color/muted"
                            android:text="" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:weightSum="1"
                            android:background="@drawable/bg_f_stroke_r3"
                            android:orientation="horizontal">
                            <View android:id="@+id/nd_srv0_bar"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_f_green_r3" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/nd_srv1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="14dp"
                        android:background="@drawable/bg_f_card_s_stroke_w1_r18"
                        android:divider="@drawable/gap_8"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <FrameLayout android:id="@+id/nd_srv1_tile"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_f_muteda14_r12">
                                <ImageView
                                    android:id="@+id/nd_srv1_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_server"
                                    android:tint="@color/muted" />
                            </FrameLayout>
                            <Space android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />
                            <FrameLayout android:id="@+id/nd_srv1_chk"
                                android:layout_width="22dp"
                                android:layout_height="22dp">
                                <ImageView
                                    android:id="@+id/nd_srv1_chkicon"
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:tint="@color/on_cyan" />
                            </FrameLayout>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/nd_srv1_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="4dp"
                            style="@style/T.Bold"
                            android:textSize="15sp"
                            android:textColor="@color/text"
                            android:text="" />
                        <TextView
                            android:id="@+id/nd_srv1_free"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Reg"
                            android:textSize="11sp"
                            android:textColor="@color/muted"
                            android:text="" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:weightSum="1"
                            android:background="@drawable/bg_f_stroke_r3"
                            android:orientation="horizontal">
                            <View android:id="@+id/nd_srv1_bar"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_f_green_r3" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Semi"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:text="PORTS MAP"
                    android:letterSpacing="0.073" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r16"
                    android:divider="@drawable/gap_10"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_link"
                        android:tint="@color/dim" />
                    <EditText
                        android:id="@+id/nd_ports"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Input"
                        android:layout_weight="1"
                        android:inputType="text"
                        android:maxLines="1"
                        android:text="8888:80" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="10sp"
                        android:textColor="@color/dim"
                        android:text="HOST : CONTAINER"
                        android:letterSpacing="0.060" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/nd_heal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_f_card_s_stroke_w1_r18"
                android:divider="@drawable/gap_12"
                android:showDividers="middle"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/nd_heal_box"
                    android:layout_width="24dp"
                    android:layout_height="24dp">
                    <ImageView
                        android:id="@+id/nd_heal_chk"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:tint="@color/on_cyan" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:divider="@drawable/gap_3"
                    android:showDividers="middle"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Bold"
                        android:textSize="14sp"
                        android:textColor="@color/text"
                        android:text="Enable Auto-Healing policy" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Reg"
                        android:textSize="11sp"
                        android:textColor="@color/muted"
                        android:text="Restart on crash · CPU &gt; 85% · RAM &gt; 90%" />
                </LinearLayout>
                <ImageView android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/cyan" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/nd_deploy"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_g_h_r16"
                android:elevation="14dp"
                android:outlineAmbientShadowColor="#8022D3EE"
                android:outlineSpotShadowColor="#8022D3EE"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="horizontal">
                <ImageView android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_zap"
                    android:tint="@color/on_cyan" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Semi"
                    android:textSize="16sp"
                    android:textColor="@color/on_cyan"
                    android:text="Execute Deploy" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
