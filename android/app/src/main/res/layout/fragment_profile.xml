<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="4dp"
    android:orientation="vertical"
    tools:ignore="HardcodedText,UselessParent,UnusedAttribute,ContentDescription,Autofill,LabelFor,TextFields,RtlSymmetry,UseCompoundDrawables,ObsoleteLayoutParam">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_2"
            android:showDividers="middle"
            android:orientation="vertical">
            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Bold"
                android:textSize="24sp"
                android:textColor="@color/text"
                android:text="Profile"
                android:letterSpacing="-0.017" />
            <TextView
                android:id="@+id/hdr_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Reg"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:text="Administrator account" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:divider="@drawable/gap_10"
            android:showDividers="middle"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_f_card_s_stroke_w1_r20"
                android:divider="@drawable/gap_10"
                android:showDividers="middle"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:divider="@drawable/gap_14"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <FrameLayout android:id="@+id/pf_avatar_box"
                        android:layout_width="66dp"
                        android:layout_height="66dp">
                        <include
                            android:id="@+id/pf_avatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            layout="@layout/view_avatar"
                            android:layout_gravity="top|start" />
                        <FrameLayout android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_oval_f_card_s_cyan_w1p5">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                android:tint="@color/cyan" />
                        </FrameLayout>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/gap_3"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Bold"
                            android:textSize="20sp"
                            android:textColor="@color/text"
                            android:text="Mạnh" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Reg"
                            android:textSize="12sp"
                            android:textColor="@color/muted"
                            android:text="manh.admin@netops.io" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_f_cyana14_r99"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        style="@style/T.Semi"
                        android:textSize="10sp"
                        android:textColor="@color/cyan"
                        android:text="SUPER ADMIN" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_f_greena14_r99"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        style="@style/T.Semi"
                        android:textSize="10sp"
                        android:textColor="@color/green"
                        android:text="RBAC: FULL ACCESS" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:background="@drawable/bg_f_card_s_stroke_w1_r20"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/pf_link_ssh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:gravity="center_vertical"
                    android:divider="@drawable/gap_12"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <FrameLayout android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_f_cyana14_r12">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_key"
                            android:tint="@color/cyan" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_3"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Semi"
                            android:textSize="14sp"
                            android:textColor="@color/text"
                            android:text="SSH Key Manager" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Reg"
                            android:textSize="11sp"
                            android:textColor="@color/muted"
                            android:text="Certificates &amp; server access" />
                    </LinearLayout>
                    <ImageView android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevr"
                        android:tint="@color/muted" />
                </LinearLayout>
                <View android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />
                <LinearLayout
                    android:id="@+id/pf_link_set"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:gravity="center_vertical"
                    android:divider="@drawable/gap_12"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <FrameLayout android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_f_bluea14_r12">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_sliders"
                            android:tint="@color/blue" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_3"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Semi"
                            android:textSize="14sp"
                            android:textColor="@color/text"
                            android:text="App Settings" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Reg"
                            android:textSize="11sp"
                            android:textColor="@color/muted"
                            android:text="Alerts, theme, refresh rate" />
                    </LinearLayout>
                    <ImageView android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevr"
                        android:tint="@color/muted" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                style="@style/T.Semi"
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:text="READ-ONLY CURRENT PERMISSIONS"
                android:letterSpacing="0.073" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:background="@drawable/bg_f_card_s_stroke_w1_r20"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_f_greena10_r10"
                        android:divider="@drawable/gap_6"
                        android:showDividers="middle"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_check"
                            android:tint="@color/green" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Med"
                            android:textSize="11sp"
                            android:textColor="@color/text"
                            android:text="Containers" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_f_greena10_r10"
                        android:divider="@drawable/gap_6"
                        android:showDividers="middle"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_check"
                            android:tint="@color/green" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Med"
                            android:textSize="11sp"
                            android:textColor="@color/text"
                            android:text="Database" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_f_greena10_r10"
                        android:divider="@drawable/gap_6"
                        android:showDividers="middle"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_check"
                            android:tint="@color/green" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Med"
                            android:textSize="11sp"
                            android:textColor="@color/text"
                            android:text="Backup &amp; Restore" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_f_greena10_r10"
                        android:divider="@drawable/gap_6"
                        android:showDividers="middle"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_check"
                            android:tint="@color/green" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Med"
                            android:textSize="11sp"
                            android:textColor="@color/text"
                            android:text="SSH Keys" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                style="@style/T.Semi"
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:text="ACTIVE DEVICES"
                android:letterSpacing="0.073" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:background="@drawable/bg_f_card_s_stroke_w1_r20"
                android:divider="@drawable/gap_12"
                android:showDividers="middle"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:divider="@drawable/gap_12"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <FrameLayout android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_f_cyana14_r12">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_phone"
                            android:tint="@color/cyan" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_3"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Semi"
                            android:textSize="14sp"
                            android:textColor="@color/text"
                            android:text="Mobile iPhone" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Reg"
                            android:textSize="11sp"
                            android:textColor="@color/muted"
                            android:text="This device · Active now" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_f_greena14_r99"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        style="@style/T.Semi"
                        android:textSize="10sp"
                        android:textColor="@color/green"
                        android:text="THIS DEVICE" />
                </LinearLayout>
                <View android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:divider="@drawable/gap_12"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <FrameLayout android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_f_bluea14_r12">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_monitor"
                            android:tint="@color/blue" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_3"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Semi"
                            android:textSize="14sp"
                            android:textColor="@color/text"
                            android:text="Web Admin · Chrome" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Reg"
                            android:textSize="11sp"
                            android:textColor="@color/muted"
                            android:text="Last seen 14 min ago" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_height="2dp"
                android:layout_width="wrap_content" />
            <LinearLayout
                android:id="@+id/pf_logout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:background="@drawable/bg_f_pinka14_s_pinka50_w1_r16"
                android:divider="@drawable/gap_10"
                android:showDividers="middle"
                android:orientation="horizontal">
                <ImageView android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_logout"
                    android:tint="@color/pink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Semi"
                    android:textSize="14sp"
                    android:textColor="@color/pink"
                    android:text="Disconnect Server / Logout" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
