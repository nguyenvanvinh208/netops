<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="4dp"
    android:orientation="vertical"
    tools:ignore="HardcodedText,UselessParent,UnusedAttribute,ContentDescription,Autofill,LabelFor,TextFields,RtlSymmetry,UseCompoundDrawables,ObsoleteLayoutParam">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:divider="@drawable/gap_12"
        android:showDividers="middle"
        android:orientation="horizontal">
        <FrameLayout android:id="@+id/hdr_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_f_card_s_stroke_w1_r14">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                android:tint="@color/text" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_2"
            android:showDividers="middle"
            android:orientation="vertical">
            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Bold"
                android:textSize="22sp"
                android:textColor="@color/text"
                android:text="Select environment"
                android:letterSpacing="-0.018"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/hdr_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Reg"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:text="Choose the cluster you want to control"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:id="@+id/env_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:divider="@drawable/gap_14"
            android:showDividers="middle"
            android:orientation="vertical" />
    </ScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">
        <LinearLayout
            android:id="@+id/env_connect"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:background="@drawable/bg_g_h_r16"
            android:elevation="14dp"
            android:outlineAmbientShadowColor="#8022D3EE"
            android:outlineSpotShadowColor="#8022D3EE"
            android:divider="@drawable/gap_8"
            android:showDividers="middle"
            android:orientation="horizontal">
            <ImageView android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_server"
                android:tint="@color/on_cyan" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Semi"
                android:textSize="16sp"
                android:textColor="@color/on_cyan"
                android:text="Connect to Environment" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
