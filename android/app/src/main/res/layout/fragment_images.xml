<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="4dp"
    android:orientation="vertical"
    tools:ignore="HardcodedText,UselessParent,UnusedAttribute,ContentDescription,Autofill,LabelFor,TextFields,RtlSymmetry,UseCompoundDrawables,ObsoleteLayoutParam">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_2"
            android:showDividers="middle"
            android:orientation="vertical">
            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Bold"
                android:textSize="24sp"
                android:textColor="@color/text"
                android:text="Containers"
                android:letterSpacing="-0.017" />
            <TextView
                android:id="@+id/hdr_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Reg"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:text="" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/hdr_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_g_diag_r14"
            android:elevation="10dp"
            android:outlineAmbientShadowColor="#FF22D3EE"
            android:outlineSpotShadowColor="#FF22D3EE">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_plus"
                android:tint="@color/on_cyan" />
        </FrameLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:divider="@drawable/gap_12"
            android:showDividers="middle"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/seg_img"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:padding="4dp"
                android:background="@drawable/bg_f_card_s_stroke_w1_r16"
                android:divider="@drawable/gap_4"
                android:showDividers="middle"
                android:orientation="horizontal" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@drawable/bg_f_field_s_cyan_w1p5_r22"
                android:elevation="12dp"
                android:outlineAmbientShadowColor="#5922D3EE"
                android:outlineSpotShadowColor="#5922D3EE"
                android:divider="@drawable/gap_12"
                android:showDividers="middle"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:divider="@drawable/gap_12"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <FrameLayout android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_f_bluea14_r14">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cloud"
                            android:tint="@color/blue" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:divider="@drawable/gap_4"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Bold"
                            android:textSize="14sp"
                            android:textColor="@color/text"
                            android:text="Azure Container Registry" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Mono"
                            android:textSize="11sp"
                            android:textColor="@color/cyan"
                            android:text="netopsprod.azurecr.io" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_f_greena14_r99"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        style="@style/T.Semi"
                        android:textSize="11sp"
                        android:textColor="@color/green"
                        android:text="Online" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp"
                        android:background="@drawable/bg_f_bga50_r12"
                        android:divider="@drawable/gap_2"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Med"
                            android:textSize="10sp"
                            android:textColor="@color/muted"
                            android:text="Images" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Bold"
                            android:textSize="14sp"
                            android:textColor="@color/text"
                            android:text="3" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp"
                        android:background="@drawable/bg_f_bga50_r12"
                        android:divider="@drawable/gap_2"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Med"
                            android:textSize="10sp"
                            android:textColor="@color/muted"
                            android:text="Total size" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Bold"
                            android:textSize="14sp"
                            android:textColor="@color/text"
                            android:text="1.9 GB" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp"
                        android:background="@drawable/bg_f_bga50_r12"
                        android:divider="@drawable/gap_2"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Med"
                            android:textSize="10sp"
                            android:textColor="@color/muted"
                            android:text="Last sync" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Bold"
                            android:textSize="14sp"
                            android:textColor="@color/text"
                            android:text="2m ago" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/T.Bold"
                    android:textSize="15sp"
                    android:textColor="@color/text"
                    android:text="Base images" />
                <LinearLayout
                    android:id="@+id/im_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:divider="@drawable/gap_5"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/cyan" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="12sp"
                        android:textColor="@color/cyan"
                        android:text="Sync" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/im_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_12"
                android:showDividers="middle"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
