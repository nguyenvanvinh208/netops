<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="4dp"
    android:orientation="vertical"
    tools:ignore="HardcodedText,UselessParent,UnusedAttribute,ContentDescription,Autofill,LabelFor,TextFields,RtlSymmetry,UseCompoundDrawables,ObsoleteLayoutParam">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical"
        android:divider="@drawable/gap_12"
        android:showDividers="middle"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_2"
            android:showDividers="middle"
            android:orientation="vertical">
            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Bold"
                android:textSize="24sp"
                android:textColor="@color/text"
                android:text="Overview"
                android:letterSpacing="-0.017" />
            <TextView
                android:id="@+id/hdr_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Reg"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/env_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:gravity="center_vertical"
            android:divider="@drawable/gap_4"
            android:showDividers="middle"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/env_pill_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Bold"
                android:textSize="10sp"
                android:textColor="@color/red"
                android:text="PROD" />
            <ImageView
                android:id="@+id/env_pill_i"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_chevd"
                android:tint="@color/red" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:divider="@drawable/gap_12"
            android:showDividers="middle"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_10"
                android:showDividers="middle"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/kpi_srv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r18"
                    android:divider="@drawable/gap_3"
                    android:showDividers="middle"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Med"
                        android:textSize="11sp"
                        android:textColor="@color/muted"
                        android:text="Servers" />
                    <TextView
                        android:id="@+id/kpi_srv_v"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Bold"
                        android:textSize="24sp"
                        android:textColor="@color/text"
                        android:text="" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:divider="@drawable/gap_5"
                        android:showDividers="middle"
                        android:orientation="horizontal">
                        <View android:id="@+id/kpi_srv_dot"
                            android:layout_width="6dp"
                            android:layout_height="6dp" />
                        <TextView
                            android:id="@+id/kpi_srv_s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Med"
                            android:textSize="11sp"
                            android:textColor="@color/text"
                            android:text="" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/kpi_cont"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r18"
                    android:divider="@drawable/gap_3"
                    android:showDividers="middle"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Med"
                        android:textSize="11sp"
                        android:textColor="@color/muted"
                        android:text="Containers" />
                    <TextView
                        android:id="@+id/kpi_cont_v"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Bold"
                        android:textSize="24sp"
                        android:textColor="@color/text"
                        android:text="" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:divider="@drawable/gap_5"
                        android:showDividers="middle"
                        android:orientation="horizontal">
                        <View android:id="@+id/kpi_cont_dot"
                            android:layout_width="6dp"
                            android:layout_height="6dp" />
                        <TextView
                            android:id="@+id/kpi_cont_s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Med"
                            android:textSize="11sp"
                            android:textColor="@color/text"
                            android:text="" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/kpi_al"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r18"
                    android:divider="@drawable/gap_3"
                    android:showDividers="middle"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Med"
                        android:textSize="11sp"
                        android:textColor="@color/muted"
                        android:text="Active alerts" />
                    <TextView
                        android:id="@+id/kpi_al_v"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Bold"
                        android:textSize="24sp"
                        android:textColor="@color/text"
                        android:text="" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:divider="@drawable/gap_5"
                        android:showDividers="middle"
                        android:orientation="horizontal">
                        <View android:id="@+id/kpi_al_dot"
                            android:layout_width="6dp"
                            android:layout_height="6dp" />
                        <TextView
                            android:id="@+id/kpi_al_s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Med"
                            android:textSize="11sp"
                            android:textColor="@color/text"
                            android:text="" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/attn_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/T.Bold"
                        android:textSize="15sp"
                        android:textColor="@color/text"
                        android:text="Needs attention" />
                    <TextView
                        android:id="@+id/attn_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="12sp"
                        android:textColor="@color/cyan"
                        android:text="View all" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/attn_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:showDividers="middle"
                    android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/srv_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/T.Bold"
                        android:textSize="15sp"
                        android:textColor="@color/text"
                        android:text="Servers" />
                    <TextView
                        android:id="@+id/srv_online"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="12sp"
                        android:textColor="@color/green"
                        android:text="2 online" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/srv_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:showDividers="middle"
                    android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_8"
                android:showDividers="middle"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/top_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/T.Bold"
                        android:textSize="15sp"
                        android:textColor="@color/text"
                        android:text="Top containers by CPU" />
                    <TextView
                        android:id="@+id/top_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="12sp"
                        android:textColor="@color/cyan"
                        android:text="View all" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/top_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r18"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
