<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="4dp"
    android:orientation="vertical"
    tools:ignore="HardcodedText,UselessParent,UnusedAttribute,ContentDescription,Autofill,LabelFor,TextFields,RtlSymmetry,UseCompoundDrawables,ObsoleteLayoutParam">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:divider="@drawable/gap_12"
        android:showDividers="middle"
        android:orientation="horizontal">
        <FrameLayout android:id="@+id/hdr_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_f_card_s_stroke_w1_r14">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                android:tint="@color/text" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_2"
            android:showDividers="middle"
            android:orientation="vertical">
            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Bold"
                android:textSize="22sp"
                android:textColor="@color/text"
                android:text="Alert details"
                android:letterSpacing="-0.018"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/hdr_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Reg"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:text="Incident #4812"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:divider="@drawable/gap_12"
            android:showDividers="middle"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@drawable/bg_f_card_s_reda50_w1_r22"
                android:divider="@drawable/gap_10"
                android:showDividers="middle"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:divider="@drawable/gap_10"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <FrameLayout android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_f_reda14_r12">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_warn"
                            android:tint="@color/red" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_f_reda14_r99"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        style="@style/T.Semi"
                        android:textSize="11sp"
                        android:textColor="@color/red"
                        android:text="CRITICAL" />
                </LinearLayout>
                <TextView
                    android:id="@+id/ad_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Bold"
                    android:textSize="22sp"
                    android:textColor="@color/text"
                    android:text="" />
                <TextView
                    android:id="@+id/ad_where"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Reg"
                    android:textSize="12sp"
                    android:textColor="@color/muted"
                    android:text="" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:divider="@drawable/gap_8"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="57dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:background="@drawable/bg_f_field_r14"
                        android:divider="@drawable/gap_2"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/ad_l0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Reg"
                            android:textSize="11sp"
                            android:textColor="@color/muted"
                            android:text="" />
                        <TextView
                            android:id="@+id/ad_v0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Bold"
                            android:textSize="18sp"
                            android:textColor="@color/text"
                            android:text="" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="57dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:background="@drawable/bg_f_field_r14"
                        android:divider="@drawable/gap_2"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/ad_l1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Reg"
                            android:textSize="11sp"
                            android:textColor="@color/muted"
                            android:text="" />
                        <TextView
                            android:id="@+id/ad_v1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Bold"
                            android:textSize="18sp"
                            android:textColor="@color/text"
                            android:text="" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="57dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:background="@drawable/bg_f_field_r14"
                        android:divider="@drawable/gap_2"
                        android:showDividers="middle"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/ad_l2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Reg"
                            android:textSize="11sp"
                            android:textColor="@color/muted"
                            android:text="" />
                        <TextView
                            android:id="@+id/ad_v2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Bold"
                            android:textSize="18sp"
                            android:textColor="@color/text"
                            android:text="" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                style="@style/T.Semi"
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:text="CRASH LOGS" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:background="@drawable/bg_f_panel_s_stroke_w1_r18"
                android:divider="@drawable/gap_7"
                android:showDividers="middle"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/ad_log0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Mono"
                    android:textSize="11sp"
                    android:textColor="@color/text"
                    android:text="" />
                <TextView
                    android:id="@+id/ad_log1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Mono"
                    android:textSize="11sp"
                    android:textColor="@color/text"
                    android:text="" />
                <TextView
                    android:id="@+id/ad_log2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Mono"
                    android:textSize="11sp"
                    android:textColor="@color/text"
                    android:text="" />
                <TextView
                    android:id="@+id/ad_log3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Mono"
                    android:textSize="11sp"
                    android:textColor="@color/text"
                    android:text="" />
                <TextView
                    android:id="@+id/ad_log4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Mono"
                    android:textSize="11sp"
                    android:textColor="@color/text"
                    android:text="" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:divider="@drawable/gap_12"
                android:showDividers="middle"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/ad_fix"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_g_h_r16"
                    android:elevation="12dp"
                    android:outlineAmbientShadowColor="#8022D3EE"
                    android:outlineSpotShadowColor="#8022D3EE"
                    android:divider="@drawable/gap_8"
                    android:showDividers="middle"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_zap"
                        android:tint="@color/on_cyan" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Semi"
                        android:textSize="16sp"
                        android:textColor="@color/on_cyan"
                        android:text="Open Terminal" />
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/ad_ignore"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_f_card_s_stroke_w1_r16">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        style="@style/T.Semi"
                        android:textSize="16sp"
                        android:textColor="@color/muted"
                        android:text="Acknowledge" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
