<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@+id/cf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#C2050810"
    android:clickable="true"
    tools:ignore="HardcodedText,UselessParent,UnusedAttribute,ContentDescription,Autofill,LabelFor,TextFields,RtlSymmetry,UseCompoundDrawables,ObsoleteLayoutParam">
    <LinearLayout
        android:id="@+id/cf_card"
        android:layout_width="318dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="22dp"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_f_card_s_reda55_w1p5_r28"
        android:elevation="24dp"
        android:outlineAmbientShadowColor="#66FB4F6D"
        android:outlineSpotShadowColor="#66FB4F6D"
        android:clickable="true"
        android:divider="@drawable/gap_14"
        android:showDividers="middle"
        android:orientation="vertical">
        <FrameLayout android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_oval_f_reda14_s_reda30_w1p5">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alert"
                android:tint="@color/red" />
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_f_reda14_r99"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            style="@style/T.Bold"
            android:textSize="11sp"
            android:textColor="@color/red"
            android:text="DISRUPTIVE ACTION"
            android:letterSpacing="0.091" />
        <TextView
            android:id="@+id/cf_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            style="@style/T.Bold"
            android:textSize="21sp"
            android:textColor="@color/text"
            android:text="" />
        <TextView
            android:id="@+id/cf_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            style="@style/T.Reg"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:text=""
            android:lineSpacingMultiplier="1.20" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="11dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_f_panel_s_stroke_w1_r14"
            android:divider="@drawable/gap_10"
            android:showDividers="middle"
            android:orientation="horizontal">
            <ImageView android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_info"
                android:tint="@color/amber" />
            <TextView
                android:id="@+id/cf_session"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/T.Mono"
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:text="" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cf_confirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:background="@drawable/bg_f_red_r16"
            android:elevation="12dp"
            android:outlineAmbientShadowColor="#80FB4F6D"
            android:outlineSpotShadowColor="#80FB4F6D"
            android:divider="@drawable/gap_8"
            android:showDividers="middle"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/cf_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_restart"
                android:tint="@color/on_red" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Bold"
                android:textSize="15sp"
                android:textColor="@color/on_red"
                android:text="CONFIRM"
                android:letterSpacing="0.053" />
        </LinearLayout>
        <FrameLayout android:id="@+id/cf_cancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_f_card_s_stroke_w1_r16">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                style="@style/T.Semi"
                android:textSize="14sp"
                android:textColor="@color/muted"
                android:text="CANCEL"
                android:letterSpacing="0.057" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
