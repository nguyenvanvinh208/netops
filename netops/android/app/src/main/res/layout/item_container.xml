<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/ct_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="14dp"
    android:background="@drawable/bg_f_card_s_stroke_w1_r20"
    android:divider="@drawable/gap_12"
    android:showDividers="middle"
    android:orientation="vertical"
    tools:ignore="HardcodedText,UselessParent,UnusedAttribute,ContentDescription,Autofill,LabelFor,TextFields,RtlSymmetry,UseCompoundDrawables,ObsoleteLayoutParam">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:divider="@drawable/gap_12"
        android:showDividers="middle"
        android:orientation="horizontal">
        <FrameLayout android:id="@+id/ct_tile"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_f_violeta14_r14">
            <ImageView
                android:id="@+id/ct_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_box"
                android:tint="@color/violet" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_4"
            android:showDividers="middle"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ct_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Bold"
                android:textSize="15sp"
                android:textColor="@color/text"
                android:text="" />
            <TextView
                android:id="@+id/ct_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Reg"
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:text=""
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <TextView
            android:id="@+id/ct_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_f_greena14_r99"
            style="@style/T.Semi"
            android:textSize="11sp"
            android:textColor="@color/green"
            android:text="" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_16"
        android:showDividers="middle"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_6"
            android:showDividers="middle"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/ct_cpu_lbl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/T.Med"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:text="CPU" />
                <TextView
                    android:id="@+id/ct_cpu_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Semi"
                    android:textSize="11sp"
                    android:textColor="@color/text"
                    android:text="" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:weightSum="1"
                android:background="@drawable/bg_f_stroke_r3"
                android:orientation="horizontal">
                <View android:id="@+id/ct_cpu_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_f_cyan_r3" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_6"
            android:showDividers="middle"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/ct_ram_lbl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/T.Med"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:text="RAM" />
                <TextView
                    android:id="@+id/ct_ram_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Semi"
                    android:textSize="11sp"
                    android:textColor="@color/text"
                    android:text="" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:weightSum="1"
                android:background="@drawable/bg_f_stroke_r3"
                android:orientation="horizontal">
                <View android:id="@+id/ct_ram_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_f_cyan_r3" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_8"
        android:showDividers="middle"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/ct_start"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_f_greena12_s_greena50_w1_r12"
            android:divider="@drawable/gap_6"
            android:showDividers="middle"
            android:orientation="horizontal">
            <ImageView android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_play"
                android:tint="@color/green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Semi"
                android:textSize="13sp"
                android:textColor="@color/green"
                android:text="Start" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ct_stop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_f_reda12_s_reda50_w1_r12"
            android:divider="@drawable/gap_6"
            android:showDividers="middle"
            android:orientation="horizontal">
            <ImageView android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_stop"
                android:tint="@color/red" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Semi"
                android:textSize="13sp"
                android:textColor="@color/red"
                android:text="Stop" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ct_restart"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_f_ambera12_s_ambera50_w1_r12"
            android:divider="@drawable/gap_6"
            android:showDividers="middle"
            android:orientation="horizontal">
            <ImageView android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_restart"
                android:tint="@color/amber" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Semi"
                android:textSize="13sp"
                android:textColor="@color/amber"
                android:text="Restart" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
