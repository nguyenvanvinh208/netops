      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Trạng thái đăng ký thành công là 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"vinh@netops.com\",\r\n  \"password\": \"123456\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Kiểm tra mã trạng thái phải là 200 OK\r\npm.test(\"Trạng thái đăng nhập thành công là 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Tự động trích xuất token và lưu vào biến môi trường\r\nvar jsonData = pm.response.json();\r\nif (jsonData.token) {\r\n    pm.environment.set(\"token\", jsonData.token);\r\n    console.log(\"Đã lưu Token thành công vào biến môi trường!\");\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"vinh_update@netops.com\",\r\n  \"password\": \"VinhNewPassword123!\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
